<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0D1829"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="#2A4070"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Schimbă parola"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Introdu parola curentă pentru confirmare"
        android:textColor="#7A9CC0"
        android:textSize="11sp"
        android:layout_marginBottom="16dp"/>

    <!-- Succes — ascuns initial -->
    <LinearLayout
        android:id="@+id/layoutSuccesParola"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#0D3020"
        android:padding="20dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅"
            android:textSize="28sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parolă schimbată!"
            android:textColor="#4CAF50"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Folosește noua parolă la următoarea autentificare."
            android:textColor="#7A9CC0"
            android:textSize="10sp"
            android:gravity="center"/>

    </LinearLayout>

    <!-- Formular — vizibil initial -->
    <LinearLayout
        android:id="@+id/layoutFormularParola"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parola curentă"
            android:textColor="#7A9CC0"
            android:textSize="10sp"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilParolaCurenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#2A4070"
            app:boxBackgroundColor="#12203A"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:passwordToggleEnabled="true"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etParolaCurenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:hint="Parola curentă"/>

        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#1A3C6E"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parolă nouă"
            android:textColor="#7A9CC0"
            android:textSize="10sp"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilParolaNouă"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#2A4070"
            app:boxBackgroundColor="#12203A"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etParolaNouа"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:hint="Parolă nouă"/>

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minim 6 caractere"
            android:textColor="#7A9CC0"
            android:textSize="10sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirmă parola nouă"
            android:textColor="#7A9CC0"
            android:textSize="10sp"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirmaParola"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#2A4070"
            app:boxBackgroundColor="#12203A"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmaParola"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:hint="Confirmă parola nouă"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Eroare -->
        <TextView
            android:id="@+id/tvEroareParola"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#E57373"
            android:textSize="10sp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"/>

        <!-- Buton salvare -->
        <LinearLayout
            android:id="@+id/btnSalveazaParola"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="#4A90D9">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salvează"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>