<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12203A"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cu ce bancă începem?"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selectează banca ta principală. Poți adăuga mai multe mai târziu."
        android:textColor="#7A9CC0"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"/>

    <!-- BCR -->
    <LinearLayout
        android:id="@+id/optionBCR"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1A3C6E"
        android:padding="16dp"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="BCR"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#E53935"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BCR"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginStart="12dp"/>
        <TextView
            android:id="@+id/checkBCR"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="#4CAF50"
            android:textSize="18sp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- ING -->
    <LinearLayout
        android:id="@+id/optionING"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1A3C6E"
        android:padding="16dp"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="ING"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#FF6D00"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ING"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginStart="12dp"/>
        <TextView
            android:id="@+id/checkING"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="#4CAF50"
            android:textSize="18sp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- BRD -->
    <LinearLayout
        android:id="@+id/optionBRD"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1A3C6E"
        android:padding="16dp"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="BRD"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#1565C0"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BRD"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginStart="12dp"/>
        <TextView
            android:id="@+id/checkBRD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="#4CAF50"
            android:textSize="18sp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Raiffeisen -->
    <LinearLayout
        android:id="@+id/optionRaiffeisen"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1A3C6E"
        android:padding="16dp"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="RAI"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#FFD600"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Raiffeisen"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginStart="12dp"/>
        <TextView
            android:id="@+id/checkRaiffeisen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="#4CAF50"
            android:textSize="18sp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Banca Transilvania -->
    <LinearLayout
        android:id="@+id/optionBT"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1A3C6E"
        android:padding="16dp"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="BT"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#003087"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Banca Transilvania"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginStart="12dp"/>
        <TextView
            android:id="@+id/checkBT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="#4CAF50"
            android:textSize="18sp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- CEC Bank -->
    <LinearLayout
        android:id="@+id/optionCEC"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1A3C6E"
        android:padding="16dp"
        android:layout_marginBottom="32dp">
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="CEC"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#006400"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CEC Bank"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginStart="12dp"/>
        <TextView
            android:id="@+id/checkCEC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="#4CAF50"
            android:textSize="18sp"
            android:visibility="gone"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnContinuaOnboarding1"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Continuă"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4CAF50"
        android:enabled="false"/>

</LinearLayout>