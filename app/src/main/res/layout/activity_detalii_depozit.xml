<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12203A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_transactions"
                android:background="#1A2E4A"
                android:padding="8dp"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/tvTitluDepozit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Depozit"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Card principal albastru -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0D47A1"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvIconitaDepozit"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="🏦"
                    android:textSize="24sp"
                    android:background="#12203A"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNumeDepozit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Depozit BRD 1 an"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvInfoDepozit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BRD • 6.00% dobanda anuala"
                        android:textColor="#B0C8F0"
                        android:textSize="11sp"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvSumaDepozit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10,000.00 RON"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suma blocata"
                android:textColor="#B0C8F0"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- Info scadenta + progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2E4A"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data deschidere"
                        android:textColor="#7A9CC0"
                        android:textSize="10sp"
                        android:layout_marginBottom="3dp"/>

                    <TextView
                        android:id="@+id/tvDataDeschidere"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="02/05/2026"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data scadenta"
                        android:textColor="#7A9CC0"
                        android:textSize="10sp"
                        android:layout_marginBottom="3dp"/>

                    <TextView
                        android:id="@+id/tvDataScadentaDetalii"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="02/05/2027"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Progres"
                    android:textColor="#7A9CC0"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvZileDepozit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 / 365 zile"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"/>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressDepozitDetalii"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="2"
                android:progressTint="#4A90D9"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#12203A"
                android:padding="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="La scadenta primesti"
                    android:textColor="#7A9CC0"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvSumaScadentaDetalii"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10,600.00 RON"
                    android:textColor="#4CAF50"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <!-- 3 statistici -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#1A2E4A"
                android:padding="10dp"
                android:gravity="center"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Suma blocata"
                    android:textColor="#7A9CC0"
                    android:textSize="9sp"
                    android:layout_marginBottom="3dp"/>

                <TextView
                    android:id="@+id/tvSumaBlockata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10,000"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#1A2E4A"
                android:padding="10dp"
                android:gravity="center"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Castig total"
                    android:textColor="#7A9CC0"
                    android:textSize="9sp"
                    android:layout_marginBottom="3dp"/>

                <TextView
                    android:id="@+id/tvCastigTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+600"
                    android:textColor="#4CAF50"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#1A2E4A"
                android:padding="10dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zile ramase"
                    android:textColor="#7A9CC0"
                    android:textSize="9sp"
                    android:layout_marginBottom="3dp"/>

                <TextView
                    android:id="@+id/tvZileRamaseDepozit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="363"
                    android:textColor="#4A90D9"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Reinnoire automata -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A2E4A"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄"
                android:textSize="20sp"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/tvReinnoireStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reinnoire automata: Dezactivata"
                android:textColor="#7A9CC0"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/btnToggleReinnoire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activeaza"
                android:textColor="#4A90D9"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- Lichidare anticipata -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#4A0000"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️"
                    android:textSize="18sp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lichidare anticipata"
                    android:textColor="#E53935"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Daca lichidezi acum vei pierde toata dobanda acumulata si vei primi inapoi doar suma initiala."
                android:textColor="#FFB0B0"
                android:textSize="11sp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnLichideaza"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Lichideaza anticipat"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E53935"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- Istoric -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Istoric"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2E4A">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:background="#0D47A1"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏦"
                        android:textSize="14sp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Depozit deschis"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/tvDataDeschidereIsoric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="02/05/2026"
                        android:textColor="#7A9CC0"
                        android:textSize="10sp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvSumaIstoric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#4A90D9"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#12203A"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:background="#1B5E20"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:textColor="#4CAF50"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dobanda la scadenta"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginEnd="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="exemplu"
                            android:textColor="#4A90D9"
                            android:textSize="9sp"
                            android:background="#12203A"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calculata la scadenta"
                        android:textColor="#7A9CC0"
                        android:textSize="10sp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDobandaIstoric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#4CAF50"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>