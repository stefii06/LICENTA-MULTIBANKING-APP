<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0D1829"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="#2A4070"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date personale"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Informațiile tale de cont"
        android:textColor="#7A9CC0"
        android:textSize="11sp"
        android:layout_marginBottom="14dp"/>

    <!-- Randuri date -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Prenume" android:textColor="#7A9CC0" android:textSize="11sp"/>
        <TextView android:id="@+id/tvDpPrenume" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="11sp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1A3C6E"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nume" android:textColor="#7A9CC0" android:textSize="11sp"/>
        <TextView android:id="@+id/tvDpNume" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="11sp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1A3C6E"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Email" android:textColor="#7A9CC0" android:textSize="11sp"/>
        <TextView android:id="@+id/tvDpEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="11sp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1A3C6E"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Telefon" android:textColor="#7A9CC0" android:textSize="11sp"/>
        <TextView android:id="@+id/tvDpTelefon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="11sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pentru modificări, contactează suportul."
        android:textColor="#7A9CC0"
        android:textSize="10sp"
        android:gravity="center"
        android:layout_marginTop="12dp"/>

</LinearLayout>