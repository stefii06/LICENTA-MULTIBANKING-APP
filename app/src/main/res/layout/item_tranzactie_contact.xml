<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_contact_info_rounded"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tvIconTranzactieContact"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="↑"
        android:textColor="#E57373"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_avatar_circle_contact"
        android:layout_marginEnd="10dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDescriereTranzactieContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trimis catre Maria"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvDataTranzactieContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 iulie 2026"
            android:textColor="#7A9CC0"
            android:textSize="10sp"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvSumaTranzactieContact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-150 RON"
        android:textColor="#E57373"
        android:textSize="13sp"
        android:textStyle="bold"/>

</LinearLayout>