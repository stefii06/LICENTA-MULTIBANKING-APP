<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12203A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_transactions"
                android:background="@drawable/bg_item_rounded"
                android:padding="8dp"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configureaza contul"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Iconite obiectiv -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iconita obiectiv"
            android:textColor="#7A9CC0"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/iconita1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="✈"
                android:textSize="22sp"
                android:background="@drawable/bg_item_rounded"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/iconita2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="🏠"
                android:textSize="22sp"
                android:background="@drawable/bg_item_rounded"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/iconita3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="🚗"
                android:textSize="22sp"
                android:background="@drawable/bg_item_rounded"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/iconita4"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="💍"
                android:textSize="22sp"
                android:background="@drawable/bg_item_rounded"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/iconita5"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="📱"
                android:textSize="22sp"
                android:background="@drawable/bg_item_rounded"/>

        </LinearLayout>

        <!-- Nume cont -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nume cont"
            android:textColor="#7A9CC0"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNumeCont"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: Vacanta Grecia 2026"
            android:layout_marginBottom="18dp"
            app:boxStrokeColor="#1A3C6E"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNumeCont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:inputType="text"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Banca sursa -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Banca sursa"
            android:textColor="#7A9CC0"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:id="@+id/spinnerBanca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_item_rounded"
            android:padding="14dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/tvBancaSelectata"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Selecteaza banca"
                android:textColor="#7A9CC0"
                android:textSize="14sp"/>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_transactions"/>

        </LinearLayout>

        <!-- Suma initiala -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suma initiala (RON)"
            android:textColor="#7A9CC0"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSumaInitiala"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:layout_marginBottom="18dp"
            app:boxStrokeColor="#1A3C6E"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSumaInitiala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:inputType="numberDecimal"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Obiectiv + Data tinta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Obiectiv (RON)"
                    android:textColor="#7A9CC0"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilObiectiv"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0"
                    app:boxStrokeColor="#1A3C6E"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etObiectiv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:inputType="numberDecimal"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data tinta"
                    android:textColor="#7A9CC0"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDataTinta"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="MM/YYYY"
                    app:boxStrokeColor="#1A3C6E"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDataTinta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:inputType="text"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Dobanda info -->
        <LinearLayout
            android:id="@+id/layoutDobanda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="#1B5E20"
            android:padding="14dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dobanda anuala"
                    android:textColor="#B0F0B0"
                    android:textSize="11sp"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/tvDobanda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.00%"
                    android:textColor="#4CAF50"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Castig estimat/an"
                    android:textColor="#B0F0B0"
                    android:textSize="11sp"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/tvCastigEstimat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0.00 RON"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnCreeazaCont"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Creeaza cont economii"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_rounded"
            android:backgroundTint="#4CAF50"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnAnuleaza"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Anuleaza"
            android:textColor="#E53935"
            android:background="@drawable/bg_button_rounded"
            android:backgroundTint="#1A2E4A"
            android:textSize="16sp"/>

    </LinearLayout>

</ScrollView>