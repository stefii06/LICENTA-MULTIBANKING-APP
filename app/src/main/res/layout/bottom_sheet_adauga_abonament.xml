<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A2E4A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        android:paddingTop="12dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:background="#7A9CC0"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adauga abonament"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Completeaza detaliile abonamentului"
            android:textColor="#7A9CC0"
            android:textSize="11sp"
            android:layout_marginBottom="16dp"/>

        <!-- Emoji + Nume -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/btnSelectEmoji"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:background="#12203A"
                android:layout_marginEnd="10dp">

                <TextView
                    android:id="@+id/tvEmojiSelectat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎬"
                    android:textSize="24sp"/>

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNumeAbonament"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nume abonament"
                app:boxStrokeColor="#1A3C6E"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNumeAbonament"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:inputType="text"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Suma -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSumaAbonament"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Suma (RON)"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="#1A3C6E"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSumaAbonament"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:inputType="numberDecimal"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ziua lunii -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ziua lunii"
            android:textColor="#7A9CC0"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/btnZiua1"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#4A90D9"
                android:layout_marginEnd="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnZiua5"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#12203A"
                android:layout_marginEnd="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textColor="#7A9CC0" android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnZiua10"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#12203A"
                android:layout_marginEnd="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10" android:textColor="#7A9CC0" android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnZiua15"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#12203A"
                android:layout_marginEnd="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15" android:textColor="#7A9CC0" android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnZiua25"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#12203A">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25" android:textColor="#7A9CC0" android:textSize="13sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Card"
            android:textColor="#7A9CC0"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/spinnerCardAbonament"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#12203A"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvCardAbonament"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BCR •••• 3377"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_transactions"/>

        </LinearLayout>

        <!-- Suma variabila -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#12203A"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Suma variabila (ex: utilitati)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchVariabil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnSalveazaAbonament"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Salveaza abonament"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4A90D9"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnAnuleazaAbonament"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Anuleaza"
            android:textColor="#E53935"
            android:backgroundTint="#12203A"/>

    </LinearLayout>

</ScrollView>