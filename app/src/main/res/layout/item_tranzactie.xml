<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_item_rounded"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tvEmojiTranzactie"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:gravity="center"
        android:text="🍔"
        android:textSize="18sp"
        android:background="@drawable/bg_icon_circle"
        android:layout_marginEnd="12dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCategorieTranzactie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mancare"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tvBadgeTranzactie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#4A90D9"
                android:textSize="9sp"
                android:background="@drawable/bg_badge_pill"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvCardTranzactie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BCR •••• 3377"
            android:textColor="#7A9CC0"
            android:textSize="10sp"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvSumaTranzactie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-47 RON"
            android:textColor="#E53935"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvActiuneTranzactie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#4CAF50"
            android:textSize="9sp"
            android:layout_marginTop="2dp"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>