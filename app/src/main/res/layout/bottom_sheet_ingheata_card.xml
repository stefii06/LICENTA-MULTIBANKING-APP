<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0D1829"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="#2A4070"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <!-- Layout optiuni — vizibil initial -->
    <LinearLayout
        android:id="@+id/layoutOptiuniIngheata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvIngheataTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Îngheață cardul"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvIngheataDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BCR •••• 4521"
            android:textColor="#7A9CC0"
            android:textSize="11sp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Optiunea 1: Ingheata in FinMind -->
        <LinearLayout
            android:id="@+id/btnIngheataFinMind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A2F50"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="❄"
                android:textColor="#4A90D9"
                android:textSize="16sp"
                android:background="#2A4070"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Îngheață în FinMind"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cardul nu va apărea la plăți în aplicație"
                    android:textColor="#7A9CC0"
                    android:textSize="10sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Optiunea 2: Ingheata la banca -->
        <LinearLayout
            android:id="@+id/btnIngheataBanca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#0D2A1A"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="↗"
                android:textColor="#4CAF50"
                android:textSize="16sp"
                android:background="#0D3A20"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Îngheață la bancă"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvIngheataBancaNume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deschide aplicația băncii"
                    android:textColor="#7A9CC0"
                    android:textSize="10sp"/>

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnAnuleazaIngheata"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Anulează"
            android:textColor="#7A9CC0"
            android:backgroundTint="#12203A"/>

    </LinearLayout>

    <!-- Layout confirmat — ascuns initial -->
    <LinearLayout
        android:id="@+id/layoutInghetatConfirmat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#0D1E35"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvInghetatSuccess"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Card îngheațat în FinMind"
                android:textColor="#4A90D9"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apasă din nou Îngheață pentru a reactiva"
                android:textColor="#7A9CC0"
                android:textSize="10sp"
                android:gravity="center"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnInchideIngheata"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Închide"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4A90D9"/>

    </LinearLayout>

</LinearLayout>