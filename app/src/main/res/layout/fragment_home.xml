<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12203A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="IS"
                android:textColor="#B0C8F0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="#1A3C6E"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bună ziua,"
                    android:textColor="#7A9CC0"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ioana Stefania"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <ImageView
                android:id="@+id/ivNotifications"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_profile"
                android:padding="6dp"
                android:background="#1A3C6E"/>

        </LinearLayout>

        <!-- Card sold + peek + wallet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <!-- Peek bar -->
            <LinearLayout
                android:id="@+id/layoutCardPeek"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:background="@drawable/bg_peek_rounded"
                android:gravity="center"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <TextView
                    android:id="@+id/tvPeekLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▲  vezi cardurile"
                    android:textColor="#CCFFD0"
                    android:textSize="10sp"/>

            </LinearLayout>

            <!-- Wallet container — populat din Java -->
            <LinearLayout
                android:id="@+id/layoutCardRevelat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_wallet_rounded"
                android:paddingTop="12dp"
                android:paddingBottom="14dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <!-- Carduri stacked — FrameLayout populat din Java -->
                <FrameLayout
                    android:id="@+id/frameWallet"
                    android:layout_width="match_parent"
                    android:layout_height="205dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Indicatori puncte -->
                <LinearLayout
                    android:id="@+id/layoutDotsWallet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="6dp"/>

                <!-- Info card selectat -->
                <TextView
                    android:id="@+id/tvInfoCardWallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#81C784"
                    android:textSize="10sp"
                    android:layout_marginBottom="12dp"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#2a5c30"
                    android:layout_marginBottom="12dp"/>

                <!-- Butoane contextuale -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnDetaliuCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_card"
                            android:background="@drawable/bg_icon_green_rounded"
                            android:padding="9dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detalii"
                            android:textColor="#81C784"
                            android:textSize="9sp"
                            android:layout_marginTop="4dp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnIngheataCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_profile"
                            android:background="@drawable/bg_icon_green_rounded"
                            android:padding="9dp"/>

                        <TextView
                            android:id="@+id/tvLabelIngheata"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Îngheață"
                            android:textColor="#81C784"
                            android:textSize="9sp"
                            android:layout_marginTop="4dp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnStergeCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_transactions"
                            android:background="@drawable/bg_icon_red_rounded"
                            android:padding="9dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Șterge"
                            android:textColor="#EF9A9A"
                            android:textSize="9sp"
                            android:layout_marginTop="4dp"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Status inghetat -->
                <TextView
                    android:id="@+id/tvStatusInghetat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Card inghetat — apasa Ingheata pentru a debloca"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:background="#4A90D9"
                    android:padding="8dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- Card sold -->
            <LinearLayout
                android:id="@+id/layoutSold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A2E4A"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sold Total"
                    android:textColor="#7A9CC0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvSoldTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5,230.00 RON"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvAlteCurrency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+120.00 EUR  +45.00 USD"
                    android:textColor="#4CAF50"
                    android:textSize="12sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Butoane rapide -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_quickactions_card"
            android:padding="14dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acțiuni rapide"
                android:textColor="#7A9CC0"
                android:textSize="10sp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:id="@+id/btnTrimite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_action_normal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_transactions"
                        android:padding="1dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trimite"
                        android:textColor="#A8C8E8"
                        android:textSize="10sp"
                        android:layout_marginTop="5dp"/>

                </LinearLayout>

                <View
                    android:layout_width="6dp"
                    android:layout_height="1dp"/>

                <LinearLayout
                    android:id="@+id/btnPlateste"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_action_plateste"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_card"
                        android:padding="1dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plătește"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"/>

                </LinearLayout>

                <View
                    android:layout_width="6dp"
                    android:layout_height="1dp"/>

                <LinearLayout
                    android:id="@+id/btnPrimeste"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_action_normal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_transactions"
                        android:padding="1dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Primește"
                        android:textColor="#A8C8E8"
                        android:textSize="10sp"
                        android:layout_marginTop="5dp"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAdaugaCont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_addcont_rounded"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_profile"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Adaugă cont bancar"
                    android:textColor="#7A9CC0"
                    android:textSize="12sp"/>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_statistics"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Contacte recente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Contacte recente"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvVeziToateContacte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vezi toate"
                    android:textColor="#4A90D9"
                    android:textSize="12sp"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvContacte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipToPadding="false"/>

        </LinearLayout>

        <!-- Banner tranzactii -->
        <LinearLayout
            android:id="@+id/layoutBannerTranzactii"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A2E4A"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tranzacții"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vezi istoricul complet"
                    android:textColor="#7A9CC0"
                    android:textSize="11sp"/>

            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_transactions"
                android:padding="2dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>