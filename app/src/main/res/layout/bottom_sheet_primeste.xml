<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A2E4A">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="#7A9CC0"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"/>

    <ViewFlipper
        android:id="@+id/viewFlipperPrimeste"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ===== PAS 1 — Alege contul ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Primeste bani"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alege contul in care primesti"
                android:textColor="#7A9CC0"
                android:textSize="11sp"
                android:layout_marginBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCarduriPrimeste"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:paddingEnd="32dp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnContinuaPrimeste"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Continua"
                android:backgroundTint="#4A90D9"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvAnuleazaPrimeste"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Anuleaza"
                android:textColor="#E53935"
                android:gravity="center"
                android:padding="12dp"/>

        </LinearLayout>

        <!-- ===== PAS 2 — Alege metoda ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cum vrei sa primesti?"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvSubtitluMetoda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BCR · ···· 1234"
                android:textColor="#7A9CC0"
                android:textSize="11sp"
                android:layout_marginBottom="16dp"/>

            <!-- IBAN -->
            <LinearLayout
                android:id="@+id/optionIbanPrimeste"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#12203A"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="IB"
                    android:textColor="#B0C8F0"
                    android:textSize="12sp"
                    android:background="#1A3C6E"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IBAN"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Copiaza sau distribuie IBAN-ul"
                        android:textColor="#7A9CC0"
                        android:textSize="11sp"/>

                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_transactions"/>

            </LinearLayout>

            <!-- QR -->
            <LinearLayout
                android:id="@+id/optionQRPrimeste"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#12203A"
                android:padding="14dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="QR"
                    android:textColor="#B0C8F0"
                    android:textSize="12sp"
                    android:background="#1A3C6E"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cod QR"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Genereaza QR de plata RoPay"
                        android:textColor="#7A9CC0"
                        android:textSize="11sp"/>

                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_transactions"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvInapoiPrimeste"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inapoi"
                android:textColor="#4A90D9"
                android:gravity="center"
                android:padding="12dp"/>

        </LinearLayout>

        <!-- ===== PAS 3 — QR ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cod QR de plata"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cel care plateste scaneaza acest QR"
                android:textColor="#7A9CC0"
                android:textSize="11sp"
                android:layout_marginBottom="16dp"/>

            <!-- Badge RoPay -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR demo · RoPay"
                android:textColor="#90CAF9"
                android:textSize="10sp"
                android:background="#0D47A1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginBottom="12dp"/>

            <!-- QR Image -->
            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/tvQrInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BCR · ···· 1234"
                android:textColor="#7A9CC0"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <!-- Disclaimer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#12203A"
                android:padding="10dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="In implementarea reala, acest QR ar fi generat prin infrastructura RoPay si scanat din orice aplicatie bancara participanta."
                    android:textColor="#7A9CC0"
                    android:textSize="10sp"
                    android:gravity="center"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnSalveazaQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Salveaza QR"
                android:backgroundTint="#4A90D9"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvInapoiQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inapoi"
                android:textColor="#4A90D9"
                android:gravity="center"
                android:padding="12dp"/>

        </LinearLayout>

    </ViewFlipper>

</LinearLayout>