<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0D1829">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:background="#2A4070"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FinMind"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personal Finance Manager · v1.0"
            android:textColor="#7A9CC0"
            android:textSize="11sp"
            android:layout_marginBottom="14dp"/>

        <!-- Informatii tehnice -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INFORMAȚII"
            android:textColor="#7A9CC0"
            android:textSize="9sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="7dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Versiune" android:textColor="#7A9CC0" android:textSize="11sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="v1.0" android:textColor="#FFFFFF" android:textSize="11sp"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1A3C6E"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="7dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Platformă" android:textColor="#7A9CC0" android:textSize="11sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Android" android:textColor="#FFFFFF" android:textSize="11sp"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1A3C6E"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="7dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Backend" android:textColor="#7A9CC0" android:textSize="11sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Firebase + Flask" android:textColor="#FFFFFF" android:textSize="11sp"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1A3C6E"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="7dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Asistent AI" android:textColor="#7A9CC0" android:textSize="11sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Claude · Anthropic" android:textColor="#FFFFFF" android:textSize="11sp"/>
        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1A3C6E" android:layout_marginTop="14dp" android:layout_marginBottom="14dp"/>

        <!-- Cum folosesti aplicatia -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CUM FOLOSEȘTI APLICAȚIA"
            android:textColor="#7A9CC0"
            android:textSize="9sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <!-- Feature 1 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="top">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏦" android:textSize="16sp" android:layout_marginEnd="10dp" android:layout_marginTop="1dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Conturi bancare" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Adaugă conturi de la mai multe bănci și vezi soldul total într-un singur loc." android:textColor="#7A9CC0" android:textSize="10sp" android:lineSpacingMultiplier="1.4"/>
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1A3C6E"/>

        <!-- Feature 2 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="top">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💸" android:textSize="16sp" android:layout_marginEnd="10dp" android:layout_marginTop="1dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trimite și primește bani" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transferuri instant prin număr de telefon sau IBAN. Generează un cod QR pentru a încasa bani rapid." android:textColor="#7A9CC0" android:textSize="10sp" android:lineSpacingMultiplier="1.4"/>
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1A3C6E"/>

        <!-- Feature 3 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="top">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📲" android:textSize="16sp" android:layout_marginEnd="10dp" android:layout_marginTop="1dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Plătește contactless" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Selectează cardul dorit și apropie telefonul de terminal pentru a plăti prin NFC." android:textColor="#7A9CC0" android:textSize="10sp" android:lineSpacingMultiplier="1.4"/>
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1A3C6E"/>

        <!-- Feature 4 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="top">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="16sp" android:layout_marginEnd="10dp" android:layout_marginTop="1dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Statistici lunare" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vezi unde se duc banii tăi, pe categorii și pe luni. Urmărește-ți scorul de sănătate financiară." android:textColor="#7A9CC0" android:textSize="10sp" android:lineSpacingMultiplier="1.4"/>
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1A3C6E"/>

        <!-- Feature 5 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="top">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔮" android:textSize="16sp" android:layout_marginEnd="10dp" android:layout_marginTop="1dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Predicții AI" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estimează cât vei cheltui luna viitoare bazat pe istoricul tău financiar." android:textColor="#7A9CC0" android:textSize="10sp" android:lineSpacingMultiplier="1.4"/>
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1A3C6E"/>

        <!-- Feature 6 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="top">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🤖" android:textSize="16sp" android:layout_marginEnd="10dp" android:layout_marginTop="1dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Asistent financiar AI" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Întreabă orice despre finanțele tale și primești sfaturi personalizate." android:textColor="#7A9CC0" android:textSize="10sp" android:lineSpacingMultiplier="1.4"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>