<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12203A"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:gravity="center"
        android:text="✓"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:background="#4CAF50"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cont conectat cu succes!"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvBancaConfirmare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#7A9CC0"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <!-- Card detalii cont -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A3C6E"
        android:padding="20dp"
        android:layout_marginBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Titular"
                android:textColor="#7A9CC0"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/tvTitularConfirmare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bancă"
                android:textColor="#7A9CC0"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/tvNumeBancaConfirmare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sold extras"
                android:textColor="#7A9CC0"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/tvSoldConfirmare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4CAF50"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnMergiLaFinMind"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Mergi la FinMind"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4A90D9"/>

</LinearLayout>