<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12203A">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnInapoi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#4A90D9"
            android:textSize="22sp"
            android:paddingEnd="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Predicții AI"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Tab-uri 1L / 3L / 1An -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tab1Luna"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 lună"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#4A90D9"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tab3Luni"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 luni"
            android:textColor="#7A9CC0"
            android:textSize="12sp"
            android:background="#1A2F50"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tab1An"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 an"
            android:textColor="#7A9CC0"
            android:textSize="12sp"
            android:background="#1A2F50"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card estimare totala -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A2F50"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <!-- Loading indicator -->
                <ProgressBar
                    android:id="@+id/progressBarLoading"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"/>

                <!-- Mesaj eroare server -->
                <TextView
                    android:id="@+id/tvEroare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#E57373"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvLunaPredictie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimare Iunie 2026"
                    android:textColor="#7A9CC0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvTotalPredictie"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="~2.050 RON"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvTrendPredictie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↑ +11%"
                        android:textColor="#E57373"
                        android:textSize="13sp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvSubtitluPredictie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="față de luna curentă"
                    android:textColor="#7A9CC0"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <!-- Grafic trend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A2F50"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trend predicție"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChartPredictii"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"/>

            </LinearLayout>

            <!-- Predictii pe categorii -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A2F50"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Predicții pe categorii"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="2dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mâncare" android:textColor="#FFFFFF" android:textSize="12sp"/>
                    <TextView android:id="@+id/tvPredMancare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="~0 RON" android:textColor="#FFB74D" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/progressPredMancare" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:progress="0" android:progressTint="#FFB74D" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="2dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Transport" android:textColor="#FFFFFF" android:textSize="12sp"/>
                    <TextView android:id="@+id/tvPredTransport" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="~0 RON" android:textColor="#4A90D9" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/progressPredTransport" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:progress="0" android:progressTint="#4A90D9" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="2dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Shopping" android:textColor="#FFFFFF" android:textSize="12sp"/>
                    <TextView android:id="@+id/tvPredShopping" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="~0 RON" android:textColor="#E57373" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/progressPredShopping" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:progress="0" android:progressTint="#E57373" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="2dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Divertisment" android:textColor="#FFFFFF" android:textSize="12sp"/>
                    <TextView android:id="@+id/tvPredDivertisment" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="~0 RON" android:textColor="#9C27B0" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/progressPredDivertisment" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:progress="0" android:progressTint="#9C27B0" android:layout_marginBottom="8dp"/>

            </LinearLayout>

            <!-- Insights -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0D1829"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Insights"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:id="@+id/insightRecomandare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#0D2040"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECOMANDARE"
                        android:textColor="#4A90D9"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp"/>

                    <TextView
                        android:id="@+id/tvInsightRecomandare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reducând Shopping cu 20% economisești ~80 RON/lună"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/insightAtentie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1A0D0D"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ATENȚIE"
                        android:textColor="#E57373"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp"/>

                    <TextView
                        android:id="@+id/tvInsightAtentie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cheltuielile sunt în creștere față de luna trecută"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/insightProgres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#0D1A0D"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROGRES"
                        android:textColor="#4CAF50"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp"/>

                    <TextView
                        android:id="@+id/tvInsightProgres"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Economiile tale cresc constant — continuă!"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>