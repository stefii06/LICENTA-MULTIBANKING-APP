<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0D47A1"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvIconitaDepozit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNumeDepozit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Depozit BRD 1 an"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvInfoDepozit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BRD • 6% • Scadenta: 02/05/2027"
                android:textColor="#B0C8F0"
                android:textSize="10sp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvSoldDepozit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10,000 RON"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvCastigDepozit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+600 RON"
                android:textColor="#4CAF50"
                android:textSize="10sp"/>

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressDepozit"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="2"
        android:progressTint="#4A90D9"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvZileDepozit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 / 365 zile"
        android:textColor="#B0C8F0"
        android:textSize="9sp"/>

</LinearLayout>