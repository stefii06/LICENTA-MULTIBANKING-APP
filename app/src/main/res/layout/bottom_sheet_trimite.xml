<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A2E4A">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="#7A9CC0"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"/>

    <ViewFlipper
        android:id="@+id/viewSwitcherTrimite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ===== PAS 1 — Alege contul sursa ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trimite bani"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alege contul din care trimiti"
                android:textColor="#7A9CC0"
                android:textSize="11sp"
                android:layout_marginBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCarduriTrimite"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnContinuaPas1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Continua"
                android:backgroundTint="#4A90D9"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvAnuleazaPas1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Anuleaza"
                android:textColor="#E53935"
                android:gravity="center"
                android:padding="12dp"/>

        </LinearLayout>

        <!-- ===== PAS 2 — Alege destinatar ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Catre cine trimiti?"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Contacte salvate -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contacte salvate"
                android:textColor="#7A9CC0"
                android:textSize="11sp"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvContacteTrimite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:nestedScrollingEnabled="false"/>

            <!-- Numar nou -->
            <LinearLayout
                android:id="@+id/optionNrNou"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#12203A"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="NR"
                    android:textColor="#B0C8F0"
                    android:textSize="11sp"
                    android:background="#1A3C6E"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Numar de telefon nou"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trimite prin RoPay la orice numar"
                        android:textColor="#7A9CC0"
                        android:textSize="11sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- IBAN -->
            <LinearLayout
                android:id="@+id/optionIbanTrimite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#12203A"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="IB"
                    android:textColor="#B0C8F0"
                    android:textSize="11sp"
                    android:background="#1A3C6E"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prin IBAN"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Introdu IBAN-ul destinatarului"
                        android:textColor="#7A9CC0"
                        android:textSize="11sp"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvInapoiPas2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inapoi"
                android:textColor="#4A90D9"
                android:gravity="center"
                android:padding="12dp"/>

        </LinearLayout>

        <!-- ===== PAS 3 — Suma + motiv ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvTitluDestinatarPas3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trimite bani"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvSubtitluDestinatarPas3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0722 xxx xxx"
                android:textColor="#7A9CC0"
                android:textSize="11sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suma (RON)"
                android:textColor="#7A9CC0"
                android:textSize="11sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etSumaTrimite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0.00"
                android:textColor="#FFFFFF"
                android:textColorHint="#7A9CC0"
                android:background="#12203A"
                android:padding="14dp"
                android:inputType="numberDecimal"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Motiv (optional)"
                android:textColor="#7A9CC0"
                android:textSize="11sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etMotivTrimite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ex: chirie, masa, cadou..."
                android:textColor="#FFFFFF"
                android:textColorHint="#7A9CC0"
                android:background="#12203A"
                android:padding="14dp"
                android:inputType="text"
                android:singleLine="true"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnContinuaPas3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Continua"
                android:backgroundTint="#4A90D9"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvInapoiPas3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inapoi"
                android:textColor="#4A90D9"
                android:gravity="center"
                android:padding="12dp"/>

        </LinearLayout>

        <!-- ===== PAS 4 — Confirmare ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirma transferul"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <!-- Badge RoPay -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transfer instant · RoPay"
                android:textColor="#90CAF9"
                android:textSize="10sp"
                android:background="#0D47A1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginBottom="16dp"/>

            <!-- Detalii transfer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#12203A"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Catre"
                        android:textColor="#7A9CC0"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/tvConfirmareDestinatarTrimite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:text="—"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Suma"
                        android:textColor="#7A9CC0"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/tvConfirmareSumaTrimite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:text="0 RON"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Din cont"
                        android:textColor="#7A9CC0"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/tvConfirmareContTrimite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:text="—"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Metoda"
                        android:textColor="#7A9CC0"
                        android:textSize="12sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transfer instant"
                        android:textColor="#90CAF9"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="In implementarea reala, transferul s-ar procesa prin infrastructura RoPay"
                android:textColor="#7A9CC0"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <!-- Loading ascuns implicit -->
            <LinearLayout
                android:id="@+id/layoutLoadingTrimite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvStatusTrimite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Se proceseaza..."
                    android:textColor="#7A9CC0"
                    android:textSize="12sp"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnConfirmaTrimite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONFIRMA TRANSFERUL"
                android:backgroundTint="#4A90D9"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvInapoiPas4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inapoi"
                android:textColor="#4A90D9"
                android:gravity="center"
                android:padding="12dp"/>

        </LinearLayout>

    </ViewFlipper>

</LinearLayout>