<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12203A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:gravity="center"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#4A90D9"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvNumeComplet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nume Prenume"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Cont activ"
                android:textColor="#4CAF50"
                android:textSize="10sp"
                android:background="#1A3C6E"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

        <!-- REZUMAT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1A2F50"
            android:padding="14dp"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvNrConturi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#4CAF50"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conturi"
                    android:textColor="#7A9CC0"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <View
                android:layout_width="0.5dp"
                android:layout_height="40dp"
                android:background="#2A4070"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvScorProfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFB74D"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scor AI"
                    android:textColor="#7A9CC0"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- CARD PERSONALITATE -->
        <LinearLayout
            android:id="@+id/cardPersonalitate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0D2040"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERSONALITATE FINANCIARĂ"
                android:textColor="#7A9CC0"
                android:textSize="9sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvPersonalitatEmoji"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:background="#1A3C6E"
                    android:layout_marginEnd="10dp"
                    android:text="🧙"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPersonalitateTitlu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The Finance Wizard"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvPersonalitateScor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scor 84 • Excelent"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:background="#4CAF50"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvPersonalitateDescriere"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Economisești în somn."
                android:textColor="#B0C8F0"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="10dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#2A4070"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sfaturi pentru tine"
                android:textColor="#7A9CC0"
                android:textSize="10sp"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:id="@+id/layoutSfaturi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>

        <!-- SETARI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0D1829"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SETĂRI"
                android:textColor="#7A9CC0"
                android:textSize="9sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:id="@+id/btnDatePersonale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="👤" android:textSize="14sp" android:background="#1A3C6E" android:layout_marginEnd="10dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Date personale" android:textColor="#FFFFFF" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nume, email, telefon" android:textColor="#7A9CC0" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#7A9CC0" android:textSize="18sp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#12203A"/>

            <LinearLayout
                android:id="@+id/btnSecuritate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="🔒" android:textSize="14sp" android:background="#1A3C6E" android:layout_marginEnd="10dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Securitate" android:textColor="#FFFFFF" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Parolă, PIN, biometrie" android:textColor="#7A9CC0" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#7A9CC0" android:textSize="18sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- APLICATIE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0D1829"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APLICAȚIE"
                android:textColor="#7A9CC0"
                android:textSize="9sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:id="@+id/btnDespreAplicatie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="ℹ️" android:textSize="14sp" android:background="#0D3020" android:layout_marginEnd="10dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Despre aplicație" android:textColor="#FFFFFF" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="v1.0 · FinMind" android:textColor="#7A9CC0" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#7A9CC0" android:textSize="18sp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#12203A"/>

            <LinearLayout
                android:id="@+id/btnTermeni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="📋" android:textSize="14sp" android:background="#0D3020" android:layout_marginEnd="10dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Termeni și condiții" android:textColor="#FFFFFF" android:textSize="12sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#7A9CC0" android:textSize="18sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- LOGOUT -->
        <LinearLayout
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:background="#1A0D0D"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deconectare"
                android:textColor="#E57373"
                android:textSize="14sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>