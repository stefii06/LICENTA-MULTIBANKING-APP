<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12203A">

    <!-- Header fix -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:paddingBottom="0dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Produsele mele"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Tab-uri -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:paddingBottom="0dp">

        <TextView
            android:id="@+id/tabToate"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Toate"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="#4A90D9"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tabCurente"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Curente"
            android:textSize="13sp"
            android:textColor="#7A9CC0"
            android:background="#1A2E4A"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tabEconomii"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Economii"
            android:textSize="13sp"
            android:textColor="#7A9CC0"
            android:background="#1A2E4A"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tabDepozite"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Depozite"
            android:textSize="13sp"
            android:textColor="#7A9CC0"
            android:background="#1A2E4A"/>

    </LinearLayout>

    <!-- Linie sub tab-uri -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A2E4A"
        android:layout_marginTop="12dp"/>

    <!-- Continut scrollabil -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ===== TAB TOATE ===== -->
            <LinearLayout
                android:id="@+id/layoutTabToate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Separator CONTURI CURENTE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#1A2E4A"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  CONTURI CURENTE  "
                        android:textColor="#7A9CC0"
                        android:textSize="10sp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#1A2E4A"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutCurenteToate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"/>

                <!-- Separator ECONOMII -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#1A2E4A"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  ECONOMII  "
                        android:textColor="#7A9CC0"
                        android:textSize="10sp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#1A2E4A"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutEconomiiToate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"/>

                <!-- Separator DEPOZITE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#1A2E4A"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  DEPOZITE  "
                        android:textColor="#7A9CC0"
                        android:textSize="10sp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#1A2E4A"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutDepoziteToate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>

            <!-- ===== TAB CURENTE ===== -->
            <LinearLayout
                android:id="@+id/layoutTabCurente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Header total -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1A2E4A"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total disponibil"
                        android:textColor="#7A9CC0"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvTotalCurente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 RON"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvNrConturiCurente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="din 0 conturi curente"
                        android:textColor="#7A9CC0"
                        android:textSize="11sp"/>

                </LinearLayout>

                <!-- Lista conturi curente -->
                <LinearLayout
                    android:id="@+id/layoutListaCurente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp"/>

                <!-- Buton conecteaza cont nou -->
                <LinearLayout
                    android:id="@+id/btnConecteazaContNou"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="#1A2E4A"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+"
                        android:textColor="#4A90D9"
                        android:textSize="20sp"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conectează cont nou"
                        android:textColor="#4A90D9"
                        android:textSize="14sp"/>

                </LinearLayout>

                <!-- Separator -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1A2E4A"
                    android:layout_marginBottom="14dp"/>

                <!-- Butoane rapide -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Operațiuni rapide"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:id="@+id/btnTrimiteCards"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#1A2E4A"
                        android:padding="14dp"
                        android:layout_marginEnd="6dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_transactions"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trimite"
                            android:textColor="#7A9CC0"
                            android:textSize="10sp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnIngheataCards"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#1A2E4A"
                        android:padding="14dp"
                        android:layout_marginEnd="6dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_profile"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Îngheață"
                            android:textColor="#7A9CC0"
                            android:textSize="10sp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnDetaliiCards"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#1A2E4A"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_card"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detalii"
                            android:textColor="#7A9CC0"
                            android:textSize="10sp"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ===== TAB ECONOMII ===== -->
            <LinearLayout
                android:id="@+id/layoutTabEconomii"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#1A2E4A"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total economisit"
                            android:textColor="#7A9CC0"
                            android:textSize="10sp"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tvTotalEconomii"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 RON"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dobândă totală"
                            android:textColor="#7A9CC0"
                            android:textSize="10sp"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tvDobandaTotala"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0.00 RON"
                            android:textColor="#4CAF50"
                            android:textSize="14sp"/>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutListaEconomii"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:id="@+id/btnAdaugaContEconomii"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#1A2E4A"
                    android:padding="14dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#4A90D9"
                        android:textSize="20sp"
                        android:background="#12203A"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Adaugă cont economii nou"
                            android:textColor="#4A90D9"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Setează un obiectiv și începe să economisești"
                            android:textColor="#7A9CC0"
                            android:textSize="10sp"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ===== TAB DEPOZITE ===== -->
            <LinearLayout
                android:id="@+id/layoutTabDepozite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layoutListaDepozite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:id="@+id/btnAdaugaContDepozit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#1A2E4A"
                    android:padding="14dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#4A90D9"
                        android:textSize="20sp"
                        android:background="#12203A"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Deschide depozit nou"
                            android:textColor="#4A90D9"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dobândă de până la 6% pe an"
                            android:textColor="#7A9CC0"
                            android:textSize="10sp"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>