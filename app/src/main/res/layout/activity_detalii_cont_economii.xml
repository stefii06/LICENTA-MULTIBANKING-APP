<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12203A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_transactions"
                android:background="#1A2E4A"
                android:padding="8dp"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/tvTitluCont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cont economii"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Card principal verde -->
        <LinearLayout
            android:id="@+id/layoutCardPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1B5E20"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvIconitaCont"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="✈"
                    android:textSize="24sp"
                    android:background="#12203A"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNumeCont"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vacanta Grecia 2026"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvInfoCont"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BCR • 4.00% • Manual"
                        android:textColor="#B0F0B0"
                        android:textSize="11sp"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvSoldCont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500.00 RON"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvObiectivCont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="din 3,000.00 RON obiectiv"
                android:textColor="#B0F0B0"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- Progress bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2E4A"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Progres spre obiectiv"
                    android:textColor="#7A9CC0"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvProcent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="16.7%"
                    android:textColor="#4CAF50"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressObiectiv"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="17"
                android:progressTint="#4CAF50"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvSoldStrans"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="500 RON stransi"
                    android:textColor="#7A9CC0"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/tvSoldRamas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2,500 RON ramasi"
                    android:textColor="#7A9CC0"
                    android:textSize="10sp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#12203A"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Estimare atingere obiectiv"
                    android:textColor="#7A9CC0"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/tvEstimareData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Iunie 2026"
                    android:textColor="#4A90D9"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <!-- 3 statistici -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#1A2E4A"
                android:padding="10dp"
                android:gravity="center"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Depus total"
                    android:textColor="#7A9CC0"
                    android:textSize="9sp"
                    android:layout_marginBottom="3dp"/>

                <TextView
                    android:id="@+id/tvDepusTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500 RON"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#1A2E4A"
                android:padding="10dp"
                android:gravity="center"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dobanda"
                    android:textColor="#7A9CC0"
                    android:textSize="9sp"
                    android:layout_marginBottom="3dp"/>

                <TextView
                    android:id="@+id/tvDobandaCastigata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+8.33 RON"
                    android:textColor="#4CAF50"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#1A2E4A"
                android:padding="10dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zile ramase"
                    android:textColor="#7A9CC0"
                    android:textSize="9sp"
                    android:layout_marginBottom="3dp"/>

                <TextView
                    android:id="@+id/tvZileRamase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42"
                    android:textColor="#4A90D9"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Butoane actiuni -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnAdaugaBani"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="+ Adauga"
                android:textColor="#4CAF50"
                android:backgroundTint="#1B5E20"
                android:textSize="12sp"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnRetrage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Retrage"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1A2E4A"
                android:textSize="12sp"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnEditeaza"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Editeaza"
                android:textColor="#4A90D9"
                android:backgroundTint="#1A2E4A"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- Metoda activa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A2E4A"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvMetodaActiva"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Metoda: Manual"
                android:textColor="#7A9CC0"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/btnSchimbaMetoda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Schimba"
                android:textColor="#4A90D9"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- Savings Hacks -->
        <LinearLayout
            android:id="@+id/layoutSavingsHacks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2E4A"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Savings Hacks active"
                android:textColor="#7A9CC0"
                android:textSize="11sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/layoutHacksBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>

        </LinearLayout>

        <!-- Istoric depuneri -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Istoric depuneri"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2E4A"
            android:layout_marginBottom="8dp">

            <!-- Depunere reala -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:background="#1B5E20"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+"
                        android:textColor="#4CAF50"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDepunereNume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Depunere initiala"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/tvDepunereData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Azi"
                        android:textColor="#7A9CC0"
                        android:textSize="10sp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDepunereSuma"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#4CAF50"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#12203A"/>

            <!-- Round Up mock -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:background="#1B5E20"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🪙"
                        android:textSize="14sp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Round Up"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginEnd="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="exemplu"
                            android:textColor="#4A90D9"
                            android:textSize="9sp"
                            android:background="#12203A"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plata Mancare rotunjita"
                        android:textColor="#7A9CC0"
                        android:textSize="10sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+3.00 RON"
                    android:textColor="#4CAF50"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#12203A"/>

            <!-- Dobanda mock -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:background="#1B5E20"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:textColor="#4CAF50"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dobanda lunara"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginEnd="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="exemplu"
                            android:textColor="#4A90D9"
                            android:textSize="9sp"
                            android:background="#12203A"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calculata automat de banca"
                        android:textColor="#7A9CC0"
                        android:textSize="10sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+8.33 RON"
                    android:textColor="#4CAF50"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>