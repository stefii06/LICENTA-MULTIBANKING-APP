<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12203A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Statistici"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- SELECTOR LUNA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A2F50"
            android:padding="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/btnLunaStanga"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="‹"
                android:textColor="#4A90D9"
                android:textSize="20sp"
                android:gravity="center"
                android:background="#0D1829"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvLunaSelectata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mai 2026"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvLunaSubtitlu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="luna curentă"
                    android:textColor="#4CAF50"
                    android:textSize="9sp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/btnLunaDreapta"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="›"
                android:textColor="#2A3F60"
                android:textSize="20sp"
                android:gravity="center"
                android:background="#0D1829"/>

        </LinearLayout>

        <!-- SCOR FINANCIAR — fix, nu colapsabil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2F50"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <!-- Subtitlu cu luna -->
            <TextView
                android:id="@+id/tvScorLuna"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scor de sănătate financiară — Mai"
                android:textColor="#7A9CC0"
                android:textSize="10sp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <!-- Cerc scor -->
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartScor"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="14dp"/>

                <!-- Dreapta: label + descriere + factori -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvScorLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bun"
                        android:textColor="#4CAF50"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvScorDescriptie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Economisești constant."
                        android:textColor="#7A9CC0"
                        android:textSize="10sp"
                        android:layout_marginBottom="8dp"/>

                    <!-- 4 factori -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#0D1829"
                            android:padding="5dp"
                            android:layout_marginEnd="3dp">
                            <TextView android:id="@+id/tvFactorEconomii" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#4CAF50" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eco" android:textColor="#7A9CC0" android:textSize="8sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="/40" android:textColor="#4A5568" android:textSize="8sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#0D1829"
                            android:padding="5dp"
                            android:layout_marginEnd="3dp">
                            <TextView android:id="@+id/tvFactorStabilitate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#4CAF50" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stab" android:textColor="#7A9CC0" android:textSize="8sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="/25" android:textColor="#4A5568" android:textSize="8sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#0D1829"
                            android:padding="5dp"
                            android:layout_marginEnd="3dp">
                            <TextView android:id="@+id/tvFactorBuget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#4CAF50" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Buget" android:textColor="#7A9CC0" android:textSize="8sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="/20" android:textColor="#4A5568" android:textSize="8sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#0D1829"
                            android:padding="5dp">
                            <TextView android:id="@+id/tvFactorTrend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#4CAF50" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trend" android:textColor="#7A9CC0" android:textSize="8sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="/15" android:textColor="#4A5568" android:textSize="8sp"/>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Buton Cere sfat AI -->
            <LinearLayout
                android:id="@+id/btnCereSfatAI"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#0D1829"
                android:padding="10dp">

                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:text="✦"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="#4A90D9"
                    android:layout_marginEnd="10dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cere sfat AI"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deschide asistentul financiar"
                        android:textColor="#7A9CC0"
                        android:textSize="10sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textColor="#4A90D9"
                    android:textSize="18sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- CARD 1: REZUMAT LUNAR — colapsabil, deschis default -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2F50"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/headerRezumat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="#4CAF50"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvTitluRezumat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rezumat — Mai"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvArrowRezumat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="#7A9CC0"
                    android:textSize="14sp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bodyRezumat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="#0D1829" android:padding="8dp" android:layout_marginEnd="6dp">
                        <View android:layout_width="6dp" android:layout_height="6dp" android:background="#4CAF50" android:layout_gravity="center" android:layout_marginBottom="3dp"/>
                        <TextView android:id="@+id/tvVenituri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 RON" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Venituri" android:textColor="#7A9CC0" android:textSize="9sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="#0D1829" android:padding="8dp" android:layout_marginEnd="6dp">
                        <View android:layout_width="6dp" android:layout_height="6dp" android:background="#E57373" android:layout_gravity="center" android:layout_marginBottom="3dp"/>
                        <TextView android:id="@+id/tvCheltuieli" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 RON" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cheltuieli" android:textColor="#7A9CC0" android:textSize="9sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="#0D1829" android:padding="8dp">
                        <View android:layout_width="6dp" android:layout_height="6dp" android:background="#FFB74D" android:layout_gravity="center" android:layout_marginBottom="3dp"/>
                        <TextView android:id="@+id/tvEconomii" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 RON" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Economii" android:textColor="#7A9CC0" android:textSize="9sp"/>
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="3dp">
                    <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="Venituri" android:textColor="#7A9CC0" android:textSize="10sp"/>
                    <ProgressBar android:id="@+id/progressVenituri" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_gravity="center_vertical" android:max="100" android:progress="100" android:progressTint="#4CAF50"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="3dp">
                    <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="Cheltuieli" android:textColor="#7A9CC0" android:textSize="10sp"/>
                    <ProgressBar android:id="@+id/progressCheltuieli" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_gravity="center_vertical" android:max="100" android:progress="0" android:progressTint="#E57373"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="Economii" android:textColor="#7A9CC0" android:textSize="10sp"/>
                    <ProgressBar android:id="@+id/progressEconomii" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_gravity="center_vertical" android:max="100" android:progress="0" android:progressTint="#FFB74D"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:id="@+id/tvPlanSubtitlu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ai X RON disponibili" android:textColor="#7A9CC0" android:textSize="10sp"/>
                    <TextView android:id="@+id/tvPlanStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ On track" android:textColor="#4CAF50" android:textSize="10sp"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- CARD 2: DISTRIBUTIE CHELTUIELI — colapsabil, deschis default -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2F50"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/headerDistributie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <View android:layout_width="6dp" android:layout_height="6dp" android:background="#4A90D9" android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvTitluDistributie"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Distribuție — Mai"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvArrowDistributie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="#7A9CC0"
                    android:textSize="14sp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bodyDistributie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/donutChart"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"/>

                <LinearLayout
                    android:id="@+id/layoutLegendaCategorii"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- CARD 3: TREND — colapsabil, inchis default -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2F50"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/headerTrend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <View android:layout_width="6dp" android:layout_height="6dp" android:background="#E57373" android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Trend 6 luni"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvArrowTrend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▸"
                    android:textColor="#7A9CC0"
                    android:textSize="14sp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvPreviewTrend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cheltuieli în scădere față de luna trecută"
                android:textColor="#7A9CC0"
                android:textSize="10sp"
                android:paddingStart="14dp"
                android:paddingBottom="10dp"
                android:visibility="visible"/>

            <LinearLayout
                android:id="@+id/bodyTrend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <Spinner
                        android:id="@+id/spinnerLineChart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#0D1829"
                        android:padding="6dp"/>

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/tvBadgeLineChart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mai • 0 RON"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:background="#4CAF50"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"/>

                </LinearLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- CARD 4: DETALII PER CATEGORIE — colapsabil, inchis default -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2F50"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/headerDetalii"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <View android:layout_width="6dp" android:layout_height="6dp" android:background="#9C27B0" android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvTitluDetalii"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Detalii — Mai"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvArrowDetalii"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▸"
                    android:textColor="#7A9CC0"
                    android:textSize="14sp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvPreviewDetalii"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mâncare • Transport • Shopping"
                android:textColor="#7A9CC0"
                android:textSize="10sp"
                android:paddingStart="14dp"
                android:paddingBottom="10dp"
                android:visibility="visible"/>

            <LinearLayout
                android:id="@+id/bodyDetalii"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <LinearLayout android:id="@+id/layoutDetaliiCategorii" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

            </LinearLayout>

        </LinearLayout>

        <!-- DIVIDER evoluție generală -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <View
                android:layout_width="0dp"
                android:layout_height="0.5dp"
                android:layout_weight="1"
                android:background="#2A3F60"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="evoluție generală"
                android:textColor="#4A5568"
                android:textSize="9sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0.5dp"
                android:layout_weight="1"
                android:background="#2A3F60"/>

        </LinearLayout>

        <!-- BUTON PREDICTII AI — fix la final -->
        <LinearLayout
            android:id="@+id/btnPredictii"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A3C6E"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Predicții AI"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Luna viitoare • 3 luni • 1 an"
                    android:textColor="#7A9CC0"
                    android:textSize="11sp"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#4A90D9"
                android:textSize="20sp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>