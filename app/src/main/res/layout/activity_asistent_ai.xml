<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12203A">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#0D1829">

        <TextView
            android:id="@+id/btnInapoi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#4A90D9"
            android:textSize="22sp"
            android:paddingEnd="16dp"/>

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🤖"
            android:textSize="18sp"
            android:background="#4A90D9"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asistent Financiar"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Online"
                android:textColor="#4CAF50"
                android:textSize="10sp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- LISTA MESAJE -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMesaje"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"/>

    <!-- SUGESTII -->
    <HorizontalScrollView
        android:id="@+id/scrollSugestii"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/layoutSugestii"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>

    </HorizontalScrollView>

    <!-- INPUT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#0D1829">

        <EditText
            android:id="@+id/etMesaj"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Scrie un mesaj..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="#1A2F50"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:maxLines="3"
            android:inputType="textMultiLine"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/btnTrimite"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="↑"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:background="#4A90D9"/>

    </LinearLayout>

</LinearLayout>